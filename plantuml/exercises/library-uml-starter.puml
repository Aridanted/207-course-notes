@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + getLoanPeriodDays() : int
}

class Book {
  - loanPeriodDays : int = 21
}

class DVD {
  - loanPeriodDays : int = 7
}

class ReferenceItem {
}

abstract class Person {
  - name : String
}

class Member {
  - memberNumber : String
  + login() : void
  + placeHold(item : Item) : void
}

class Librarian {
  + addItem(item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Hold {
  - datePlaced : String
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceItem
Borrowable <|.. Book
Borrowable <|.. DVD

Person <|-- Member
Person <|-- Librarian

Member "1" o-- "*" Hold : places >
Hold "*" --> "1" Item : on >

@enduml
